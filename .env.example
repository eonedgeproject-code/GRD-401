# GRD-401 Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3401
HOST=0.0.0.0
NODE_ENV=production

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# Optional: Use Helius or Quicknode for better performance
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Agent Config
AGENT_WALLET=YOUR_AGENT_WALLET_PUBKEY
MAX_POSITION_PCT=5.0
STOP_LOSS_PCT=2.5
SLIPPAGE_TOLERANCE=0.3
SIGNAL_THRESHOLD=0.75

# Signal Engine
SIGNAL_INTERVAL_MS=10000
SCAN_POOLS_COUNT=847

# WebSocket
WS_HEARTBEAT_MS=30000

# Domain (for CORS)
FRONTEND_URL=https://grd-401.com
